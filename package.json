{
  "name": "arvnfig",
  "version": "0.1.0",
  "private": true,
  "description": "Arvn's personal Obsidian preferences, one feature at a time.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "install-vault": "node esbuild.config.mjs --install",
    "install-notes": "node esbuild.config.mjs --install-notes",
    "release": "node scripts/release.mjs",
    "test:regions": "esbuild src/features/regions.ts --format=esm --outdir=.test-build --log-level=warning && node test/regions-fuzz.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
